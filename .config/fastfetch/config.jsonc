{
    "$schema": "https:#github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " ",
        "color": {
            "keys": "green",
            "title": "blue"
        }
    },
    /*
    "logo": {
        "padding": {
            "top": 2
        }
    },
    */
    "logo": {
        "type": "kitty",
        "source": "/${HOME}/Images/wallpapers/raccoon-fastfetch.png",
        "width": 28,
        "height": 14,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "modules": [
        {
            "format": " ",
            "key": "┌──────────── OS Information ────────────┐",
            "keyColor": "blue",
            "type": "custom"
        },
        {
            "color": {
                "host": "green",
                "user": "green"
            },
            "key": " ╭─ ",
            "keyColor": "green",
            "type": "title"
        },
        {
            "key": " ├─ ",
            "keyColor": "green",
            "type": "os"
        },
        {
            "key": " ├─ ",
            "keyColor": "green",
            "type": "kernel"
        },
        {
            "key": " ├─ ",
            "keyColor": "green",
            "type": "packages"
        },
        {
            "key": " ╰─  ",
            "keyColor": "green",
            "type": "shell"
        },
        {
            "format": " ",
            "key": "├───────── Hardware Information ─────────┤",
            "keyColor": "blue",
            "type": "custom"
        },
        {
            "key": " ╭─ 󰍹 ",
            "keyColor": "blue",
            "type": "display"
        },
        {
            "key": " ├─ 󰍛 ",
            "keyColor": "blue",
            "type": "cpu"
        },
        {
            "key": " ├─ 󰍛 ",
            "keyColor": "blue",
            "type": "gpu"
        },
        {
            "key": " ├─   ",
            "keyColor": "blue",
            "type": "memory"
        },
        {
            "key": " ╰─ 󱛟 ",
            "keyColor": "blue",
            "type": "disk"
        },
        {
            "format": " ",
            "key": "├───────── Software Information ─────────┤",
            "keyColor": "blue",
            "type": "custom"
        },
        {
            "key": " ╭─  ",
            "keyColor": "yellow",
            "type": "wm"
        },
        {
            "key": " ├─  ",
            "keyColor": "yellow",
            "type": "terminal"
        },
        {
            "key": " ╰─  ",
            "keyColor": "yellow",
            "type": "font"
        },
        {
            "format": " ",
            "key": "└────────────────────────────────────────┘",
            "keyColor": "blue",
            "type": "custom"
        },
        {
            "format": " ",
            "key": "                               ",
            "type": "custom"
        },
        "break"
    ]
}
